# ============================================================
#  《透明的她与真实的我》无障碍项目 — 版本控制排除规则
# ============================================================

# ------------------------------------------------------------
# 1. 游戏版权内容：绝不入库
#
#    以下目录是从「已购正版游戏」中提取 / 反编译得到的，属于游戏
#    著作权人的文字与代码资产。入库并推送等同于再分发 ——
#    在绝大部分国家和地区，再分发这类内容都是不被允许的。
#
#    它们都可以在本机重新生成（见 README.md「如何复现分析」）。
#
#    注意：verify/ 不带前导斜杠，匹配任意层级 —— 反编译产物会出现在
#    mod/verify/ 等多个位置，曾因只写根级路径而漏网。
# ------------------------------------------------------------
/extracted/
/decompiled/
verify/
/textassets/
/addressable_ids.txt

# 分析过程产生的临时输出
/scan_all.log
/extract.log
/wesay_schema.txt
/ratelimit_window.txt

# ------------------------------------------------------------
# 2. 第三方二进制与下载物：可由 build.ps1 重新获取
# ------------------------------------------------------------
/mod/bep_dl/
/mod/nvda_dl/
/mod/*.zip

# 安装包目录只保留自产的说明文件；BepInEx 运行时、NVDA 客户端 DLL
# 等第三方二进制由 mod/build.ps1 重新组装。
#
# 这里没有安装程序：补丁是 BepInEx 运行时挂载的，不修改游戏文件，
# 安装就是「把 package\ 里的东西拷进游戏根目录」，手写说明足够。
/mod/package/*
!/mod/package/安装说明.txt

# ------------------------------------------------------------
# 3. .NET 构建产物
# ------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# ------------------------------------------------------------
# 4. 系统杂物
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# 争渡接口自检脚本（tools\zdsr-probe.ps1）跑完后写在自己旁边的报告：
# 里面是某台机器的路径与进程清单，属于排障产物，不入库。
zdsr-probe-report.txt
