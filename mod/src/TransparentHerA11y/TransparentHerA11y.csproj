<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TransparentHerA11y</AssemblyName>
    <RootNamespace>TransparentHerA11y</RootNamespace>
    <Version>0.6.1</Version>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0169;CS0414;CS0649</NoWarn>
    <!-- 构建可复现：默认会把 git commit 注入 AssemblyInformationalVersion，
         导致同样源码在提交前后各编译一次就得到两个不同的 DLL，
         安装包与已部署副本对不上哈希，没法用哈希核对版本。 -->
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 光有上面两行还不够：SDK 默认 EnableSourceLink=true，Source Link 会把
         「当前 git 提交」写进 PDB，而 PDB 的内容哈希又会进 DLL 的 debug 目录
         和确定性 MVID。结果是同一个 HEAD 内重建可复现、一提交就换个哈希 ——
         等于没修好。我们不发布 PDB，Source Link 没有任何收益，直接关掉。 -->
    <EnableSourceLink>false</EnableSourceLink>
    <!-- 关掉 SDK 默认的引用裁剪，避免误伤 -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

